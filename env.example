# ===========================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ===========================================
# Copia este archivo como .env y configura los valores según tu entorno

# ===========================================
# VARIABLES REQUERIDAS
# ===========================================

# URL base de la API del backend
# Ejemplo: https://api.tudominio.com o http://localhost:8000
VITE_API_URL=https://api.tudominio.com

# ===========================================
# CONFIGURACIÓN DE AUTENTICACIÓN
# ===========================================

# Habilitar autenticación por email/contraseña
# Valores: "true" o "false"
VITE_AUTH_EMAIL_ENABLED=true

# ===========================================
# AUTENTICACIÓN MICROSOFT (Opcional)
# ===========================================

# Habilitar autenticación con Microsoft
# Valores: "true" o "false"
VITE_AUTH_MICROSOFT_ENABLED=false

# ID de cliente de Microsoft (requerido si VITE_AUTH_MICROSOFT_ENABLED=true)
# Obtén este valor desde el Azure Portal
VITE_AUTH_MICROSOFT_CLIENT_ID=tu_client_id_de_microsoft

# ID del tenant de Microsoft (requerido si VITE_AUTH_MICROSOFT_ENABLED=true)
# Puede ser un ID específico o "common" para multi-tenant
VITE_AUTH_MICROSOFT_TENANT_ID=tu_tenant_id_o_common

# URI de redirección para Microsoft (requerido si VITE_AUTH_MICROSOFT_ENABLED=true)
# Debe coincidir con la configuración en Azure Portal
VITE_AUTH_MICROSOFT_REDIRECT_URI=http://localhost:3002/auth/callback/microsoft

# ===========================================
# AUTENTICACIÓN GOOGLE (Opcional)
# ===========================================

# Habilitar autenticación con Google
# Valores: "true" o "false"
VITE_AUTH_GOOGLE_ENABLED=false

# ID de cliente de Google (requerido si VITE_AUTH_GOOGLE_ENABLED=true)
# Obtén este valor desde Google Cloud Console
VITE_AUTH_GOOGLE_CLIENT_ID=tu_client_id_de_google

# URI de redirección para Google (requerido si VITE_AUTH_GOOGLE_ENABLED=true)
# Debe coincidir con la configuración en Google Cloud Console
VITE_AUTH_GOOGLE_REDIRECT_URI=http://localhost:3002/auth/callback/google

# ===========================================
# reCAPTCHA v3 (Opcional)
# ===========================================

# Site Key de reCAPTCHA v3 (opcional)
# Obtén este valor desde Google reCAPTCHA Admin Console
# https://www.google.com/recaptcha/admin
# Si no se proporciona, reCAPTCHA no se utilizará
VITE_RECAPTCHA_SITE_KEY=tu_site_key_de_recaptcha

# ===========================================
# NOTAS IMPORTANTES
# ===========================================

# 1. Todas las variables que empiezan con VITE_ son accesibles en el frontend
# 2. NO incluyas información sensible como claves secretas en variables VITE_
# 3. Para producción, cambia las URLs de localhost por tus dominios reales
# 4. Las URIs de redirección deben coincidir exactamente con la configuración
#    en los proveedores de autenticación (Microsoft/Google)
# 5. Si no necesitas autenticación social, deja las variables en "false"
